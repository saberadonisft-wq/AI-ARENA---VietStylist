# Môi trường chạy Backend Việt phục Remix
ENVIRONMENT=development
HOST=0.0.0.0
PORT=4000
DEBUG=True
LOOKBOOK_COMMUNITY_ENABLED=true

# CORS: production must list the actual HTTPS frontend origin, not localhost.
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Runtime: copy the Session pooler URI from Supabase Connect (port 5432).
# Replace the password locally; never commit credentials.
SUPABASE_DATABASE_URL=postgresql://postgres.PROJECT_REF:REPLACE_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_SCHEMA=vietstylist
DATABASE_POOL_SIZE=8
# SQLite is only for ENVIRONMENT=test; pytest sets its own disposable URL.
# DATABASE_URL=sqlite:///./viet_phuc_remix.db
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-for-local-dev-vietphucremix2026

# Google ID token audience (must match the frontend OAuth client)
GOOGLE_CLIENT_ID=

# Cloudflare R2 Storage (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PUBLIC=viet-phuc-public
R2_BUCKET_PRIVATE=viet-phuc-private
R2_PUBLIC_DOMAIN=https://media.vietphucremix.example
LOCAL_MEDIA_DIR=./media_storage

# Gemini API. Keep secrets only in backend/.env; never commit or paste them into source.
GEMINI_API_KEY=
# Styling automatically falls back through 3.8 -> 3.7 -> 3.6 -> 3.5.
GEMINI_MODEL_TEXT=gemini-3.8-flash
GEMINI_MODEL_IMAGE=gemini-2.5-flash-image
# Enable only after the image model is available for the configured API key.
GEMINI_TRY_ON_ENABLED=False

# Worker Configuration
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_SECONDS=3

# JWT and deployment origins (production requires strong secret, HTTPS, and non-local hosts)
AUTH_MODE=local
JWT_SIGNING_SECRET=
JWT_ISSUER=viet-phuc-remix
JWT_AUDIENCE=viet-phuc-remix-api
FRONTEND_PUBLIC_ORIGIN=http://localhost:3000
API_PUBLIC_ORIGIN=http://localhost:4000
# Production also requires an HTTPS R2_PUBLIC_DOMAIN and all three R2 credentials.
# Local routes are always disabled outside development/test.
LOCAL_MEDIA_ENABLED=true
MEDIA_IMAGE_MAX_BYTES=10485760
MEDIA_VIDEO_MAX_BYTES=52428800
MEDIA_MAX_PIXELS=40000000
MEDIA_UPLOAD_TTL=900
MEDIA_OPERATION_LEASE=600
# Install ffprobe separately if MP4 uploads are needed.
FFPROBE_PATH=ffprobe
