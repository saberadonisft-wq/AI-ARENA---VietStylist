{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CulturalAssertion",
  "type": "object",
  "required": [
    "id",
    "subject_id",
    "predicate",
    "value",
    "qualifiers",
    "evidence",
    "confidence",
    "consensus",
    "review_status"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "subject_id": {
      "type": "string"
    },
    "predicate": {
      "type": "string"
    },
    "value": {},
    "qualifiers": {
      "type": "object",
      "additionalProperties": true
    },
    "statement_vi": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "locator"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "locator": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "consensus": {
      "type": "string",
      "enum": [
        "single_source",
        "corroborated",
        "strong_consensus",
        "mixed",
        "disputed",
        "uncertain"
      ]
    },
    "review_status": {
      "type": "string"
    }
  },
  "additionalProperties": false
}