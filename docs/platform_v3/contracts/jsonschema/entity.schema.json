{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Entity",
  "type": "object",
  "required": [
    "id",
    "entity_type",
    "schema_version",
    "identity",
    "status",
    "version",
    "extensions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "entity_type": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "string"
    },
    "identity": {
      "type": "object",
      "required": [
        "name_vi"
      ],
      "properties": {
        "name_vi": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "under_review",
        "verified",
        "published",
        "deprecated"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "extensions": {
      "type": "object"
    }
  },
  "additionalProperties": false
}