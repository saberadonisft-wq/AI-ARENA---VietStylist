# Replace with the public HTTPS API origin BEFORE building for production.
# The value is embedded in the browser bundle; changing it requires a rebuild.
NEXT_PUBLIC_API_ORIGIN=http://localhost:4000
NEXT_PUBLIC_APP_NAME="Việt phục Remix - VietStylist"
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Rebuild the frontend after changing this flag. Defaults to false.
NEXT_PUBLIC_STUDIO_V3=false
